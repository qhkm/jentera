{
  "name": "jentera-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#242c29' --iconBackgroundColorDark '#242c29' --splashBackgroundColor '#242c29' --splashBackgroundColorDark '#242c29' --logoSplashTargetWidth 512",
    "sync": "bash scripts/sync.sh",
    "copy": "pnpm -C ../app build && cap copy",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/keyboard": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "sharp": "0.34.4"
    }
  }
}
