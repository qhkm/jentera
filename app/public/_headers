# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Cloudflare combines every matching rule. Keep caching out of the global
# security block so route-specific policies are not cancelled by no-store.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

# The installed app checks these on every launch; a cached copy would pin a
# phone to an old release until the browser's 24-hour worker check ran.
/sw.js
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
/offline.html
  Cache-Control: no-cache, must-revalidate

# These contain no account state and change only with a deployment. A short
# public cache prevents needless origin reads while keeping discovery fresh.
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

# SPA shell and every route it serves. The CSP ships Report-Only until it
# has run in production without violations (Jentera → My Business → open
# every major view); flip Content-Security-Policy-Report-Only to
# Content-Security-Policy once clean.
# Google SDK/debugging is allowed for script elements only, not eval or workers.
# Regional GA collection hosts and preview fonts follow Google's CSP guide.
# No advertising script/connection origins are added. img-src retains HTTPS
# images. Keep a single policy: Pages combines matching header values.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; script-src-elem 'self' https://challenges.cloudflare.com https://www.googletagmanager.com https://tagmanager.google.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://tagmanager.google.com https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.jentera.ai wss://api.jentera.ai https://aisar-api.qhkmdev90.workers.dev wss://aisar-api.qhkmdev90.workers.dev https://aisar-vault-deposit.qhkmdev90.workers.dev https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Public route shells can change on every release, so every request
# revalidates. Deliberately no-store-free: these pages hold no account state,
# and no-store forbade the edge and the crawler from keeping a copy to
# revalidate against, so every hit became a full origin fetch. `no-cache`
# with an ETag gets the same freshness for a 304. Authenticated routes below
# keep no-store, where it is doing real work.
# These exact rules do not overlap sitemap.xml or robots.txt.
/
  Cache-Control: no-cache, must-revalidate
/ms
  Cache-Control: no-cache, must-revalidate
/pricing
  Cache-Control: no-cache, must-revalidate
/about
  Cache-Control: no-cache, must-revalidate
/connect
  Cache-Control: no-cache, must-revalidate
/connect/*
  Cache-Control: no-cache, must-revalidate
/privacy
  Cache-Control: no-cache, must-revalidate
/terms
  Cache-Control: no-cache, must-revalidate

# Duplicate noindex in the response as well as each static private shell.
# Query strings do not change the path match; no private data is prerendered.
/app
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
/app/*
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow
/signin
