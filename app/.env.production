# Baked into the production bundle by `vite build`.
# Without this, gate.tsx takes the `!API` branch, the app runs entirely on
# localStorage, and the tree-shaker strips every backend call from the
# bundle — which is exactly what shipped to jentera.ai before this file.
#
# api.jentera.ai rather than the workers.dev name: it is same-site with
# jentera.ai, which is kinder to the session cookie, and it is a domain
# we can prove ownership of for Google's OAuth consent screen.
VITE_API_URL=https://api.jentera.ai
