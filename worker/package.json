{
  "name": "aisar-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "waf:dry-run": "node scripts/apply-waf.mjs",
    "waf:apply": "node scripts/apply-waf.mjs --apply",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute aisar --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute aisar --remote --file=./schema.sql",
    "db:migrate:runtime-safety": "node scripts/apply-runtime-safety.mjs",
    "db:migrate:business-plan": "node scripts/apply-business-plan.mjs",
    "db:migrate:webhook-updates": "node scripts/apply-webhook-updates.mjs",
    "db:migrate:drift-sweep": "node scripts/apply-drift-sweep.mjs",
    "db:migrate:runtime-task-recovery": "node scripts/apply-runtime-task-recovery.mjs",
    "db:migrate:fmcv-rider-spend": "node scripts/apply-fmcv-rider-spend.mjs",
    "db:migrate:fmcv-rider-spend-microusd": "node scripts/apply-fmcv-rider-spend-microusd.mjs",
    "db:migrate:routines": "node scripts/apply-routines.mjs",
    "db:migrate:runtime-budget-token-caps": "node scripts/apply-runtime-budget-token-caps.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
