{
  "name": "aisar-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node --test scripts/bootstrap-contract.test.mjs scripts/bundle-pack.test.mjs scripts/check-apps-flags.test.mjs scripts/check-migrations-applied.test.mjs && node scripts/check-transfer-fields.mjs && node scripts/check-bundle-pin.mjs && node scripts/check-apps-flags.mjs && node scripts/check-migrations-applied.mjs",
    "deploy": "wrangler deploy",
    "deploy:sites": "node scripts/check-apps-flags.mjs && node scripts/check-migrations-applied.mjs && node scripts/prepare-sites-assets.mjs && wrangler deploy --env sites",
    "waf:dry-run": "node scripts/apply-waf.mjs",
    "waf:apply": "node scripts/apply-waf.mjs --apply",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "db:local": "wrangler d1 execute aisar --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute aisar --remote --file=./schema.sql",
    "db:migrate:runtime-safety": "node scripts/apply-runtime-safety.mjs",
    "db:migrate:runtime-spares": "node scripts/apply-runtime-spares.mjs",
    "db:migrate:runtime-spare-recovery": "node scripts/apply-runtime-spares.mjs --recovery",
    "db:migrate:business-plan": "node scripts/apply-business-plan.mjs",
    "db:migrate:webhook-updates": "node scripts/apply-webhook-updates.mjs",
    "db:migrate:drift-sweep": "node scripts/apply-drift-sweep.mjs",
    "db:migrate:runtime-task-recovery": "node scripts/apply-runtime-task-recovery.mjs",
    "db:migrate:fmcv-rider-spend": "node scripts/apply-fmcv-rider-spend.mjs",
    "db:migrate:fmcv-rider-spend-microusd": "node scripts/apply-fmcv-rider-spend-microusd.mjs",
    "db:migrate:routines": "node scripts/apply-routines.mjs",
    "db:migrate:runtime-budget-token-caps": "node scripts/apply-runtime-budget-token-caps.mjs",
    "db:migrate:work-record-kind": "node scripts/apply-work-record-kind.mjs",
    "db:migrate:runtime-task-stream-seq": "node scripts/apply-runtime-task-stream-seq.mjs",
    "db:migrate:model-call": "node scripts/apply-model-call.mjs",
    "db:migrate:runtime-identity": "node scripts/apply-runtime-identity.mjs",
    "db:migrate:specialist-profiles": "node scripts/apply-specialist-profiles.mjs",
    "db:migrate:bot-preferences": "node scripts/apply-bot-preferences.mjs",
    "db:migrate:specialist-role-avatars": "node scripts/apply-specialist-role-avatars.mjs",
    "db:migrate:notifications": "node scripts/apply-notifications-and-agent-routines.mjs",
    "db:migrate:business-plan-team": "node scripts/apply-business-plan-team.mjs",
    "db:migrate:chat-session": "node scripts/apply-chat-session.mjs",
    "db:migrate:invitation": "node scripts/apply-invitation.mjs",
    "db:migrate:workspace": "node scripts/apply-workspace.mjs",
    "db:migrate:notification-kinds": "node scripts/apply-notification-kinds.mjs",
    "db:migrate:team-plan-gate": "node scripts/apply-team-plan-gate.mjs",
    "db:migrate:fact-proposals": "node scripts/apply-fact-proposals.mjs",
    "db:migrate:activation-milestone": "node scripts/apply-activation-milestone.mjs",
    "db:migrate:goals": "node scripts/apply-goals.mjs",
    "db:migrate:goal-checkpoints": "node scripts/apply-goal-checkpoints.mjs",
    "db:migrate:vault-connection": "node scripts/apply-vault-connection.mjs",
    "db:migrate:chat-preview": "node scripts/apply-chat-preview.mjs",
    "db:migrate:runtime-egress": "node scripts/apply-runtime-egress.mjs",
    "db:migrate:apps-bookings": "node scripts/apply-apps-bookings.mjs",
    "db:migrate:booking-details": "node scripts/apply-booking-details.mjs",
    "db:migrate:booking-branding": "node scripts/apply-booking-branding.mjs",
    "db:migrate:booking-page-theme": "node scripts/apply-booking-page-theme.mjs",
    "db:migrate:booking-page-welcome-copy": "node scripts/apply-booking-page-welcome-copy.mjs",
    "db:migrate:booking-customer-changes": "node scripts/apply-booking-customer-changes.mjs",
    "db:migrate:booking-reminders-cutoff": "node scripts/apply-booking-reminders-cutoff.mjs",
    "db:migrate:booking-availability-protection": "node scripts/apply-booking-availability-protection.mjs",
    "runtime:move-region": "node scripts/move-runtime-region.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stripe-canary": "vitest run --config vitest.stripe-canary.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@types/node": "^22.20.3",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "stripe": "22.6.2"
  }
}
